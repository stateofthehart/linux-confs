# kanshi — auto-applies monitor arrangements when outputs connect/disconnect.
# A profile fires only when its output set EXACTLY matches the connected set.
#
# MATCHING STRATEGY
# The three externals are identical DELL S2725QC panels, so they are matched by
# EDID ("make model serial") rather than by connector name. DisplayLink assigns
# DVI-I-N names in whatever order the dock enumerates, which is why the old
# config needed a duplicate "swapped" profile. Serials are stable, so each panel
# keeps its spot no matter which connector it lands on:
#     left   = 5NC8S84
#     middle = JKZG464
#     right  = 9ZK7S84
# The built-in panel reports serial "Unknown", so it is matched by name (eDP-1),
# which is stable for an internal display anyway.
#
# WHY wdisplays CHANGES DON'T STICK
# wdisplays applies layout live over wlr-output-management-v1 and writes nothing
# to disk. `swaymsg reload` re-runs `exec_always pkill -x kanshi; kanshi`
# (~/.config/sway/config line 18), restarting kanshi so it re-asserts whichever
# profile matches. To make a layout permanent, capture it into THIS file.
#
# RE-CAPTURE a layout after rearranging in wdisplays:
#   swaymsg -t get_outputs | jq -r '.[] | select(.active) |
#     "    output \"\(.make) \(.model) \(.serial)\" mode \(.current_mode.width)x\(.current_mode.height) position \(.rect.x),\(.rect.y) scale \(.scale)"'
#
# Reload kanshi without a full sway reload:
#   pkill -x kanshi; kanshi &


# ── Docked: three 27" Dells side by side, laptop to their right ──────────────
# Captured live 2026-10-07. Panels are 4K-capable (3840x2160) but currently
# driven at 2560x1440; see the commented 4K variant below to switch.
profile docked {
    output "Dell Inc. DELL S2725QC 5NC8S84" mode 2560x1440 position 0,0      scale 1
    output "Dell Inc. DELL S2725QC JKZG464" mode 2560x1440 position 2560,0   scale 1
    output "Dell Inc. DELL S2725QC 9ZK7S84" mode 2560x1440 position 5120,0   scale 1
    output eDP-1                            mode 1920x1080 position 7680,360 scale 1
}

