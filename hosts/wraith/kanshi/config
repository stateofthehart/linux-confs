# ── Fallback: DisplayLink down, only the native DP head + laptop ─────────────
# Matches by CONNECTOR NAME on purpose: this fires when evdi/DisplayLinkManager
# isn't running (e.g. an evdi DKMS build failure after a kernel upgrade), and
# whichever Dell happens to be on the native port should work. Positions are
# chosen, not captured — laptop left, external right.
profile native-only {
    output eDP-1 mode 1920x1080 position 0,0    scale 1
    output DP-1  mode 2560x1440 position 1920,0 scale 1
}

# ── Undocked: laptop only ────────────────────────────────────────────────────
profile undocked {
    output eDP-1 mode 1920x1080 position 0,0 scale 1
}


