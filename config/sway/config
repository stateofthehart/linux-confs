### ~/.config/sway/config
### Ported from your i3 config (Xubuntu) to Sway (Wayland)

set $mod Mod1
set $wndw Mod4

font pango:monospace 8

# --- Apps you can swap ---
set $term kitty
set $menu rofi -show drun -show-icons
set $winmenu rofi -show window

# Start XDG autostart entries
exec_always dex --autostart --environment sway

# Monitor layout persistence (reads ~/.config/kanshi/config)
exec_always pkill -x kanshi; kanshi

# Failsafe: if a monitor combo has no kanshi profile and sway stacks outputs at
# 0,0, spread them left-to-right instead of leaving them overlapping.
# (Script self-singletons via flock, so no pkill needed here.)
exec_always ~/.config/sway/scripts/output-catchall.sh --listen

# Notifications (Wayland-native)
exec_always mako

# --- Screen lock / idle ---
# Locks after 10 min idle
exec_always pkill -x swayidle; swayidle -w \
  timeout 600 '~/.config/sway/scripts/lock.sh'

# Pol-kit auth (script resolves the distro-specific agent path)
exec_always ~/.config/sway/scripts/polkit-agent.sh

exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway SWAYSOCK DBUS_SESSION_BUS_ADDRESS

# gnome-keyring is started by systemd --user via gnome-keyring-daemon.socket

# Network and Bluetooth are handled by waybar modules (custom/network and custom/bluetooth)
# No need for nm-applet or blueman-applet in tray

exec_always --no-startup-id swayosd-server
# NOTE: there is no binary called plain `swayosd`. The package ships
# swayosd-server (the daemon, above), swayosd-client (invoked per keypress) and
# swayosd-libinput-backend (watches keys globally, needs input-group access and
# is normally run as a SYSTEM systemd unit, not from here). The old
# `exec_always swayosd` line here failed silently on every sway start.
#
# Nothing in this config binds swayosd-client, so the OSD has never actually
# displayed. To enable it: `systemctl enable --now swayosd-libinput-backend`
# for automatic volume/brightness popups, or bind swayosd-client explicitly,
# e.g. bindsym XF86AudioRaiseVolume exec swayosd-client --output-volume raise

input type:touchpad {
    tap enabled
    dwt enabled              # disable-while-typing
    natural_scroll enabled   # optional
    pointer_accel 0.3        # optional tuning
}

# Volume keys (capped at 100% using wpctl -l 1.0)
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec ~/.config/waybar/scripts/volume.sh up && $refresh_i3status
bindsym XF86AudioLowerVolume exec ~/.config/waybar/scripts/volume.sh down && $refresh_i3status
bindsym XF86AudioMute exec ~/.config/waybar/scripts/volume.sh toggle && $refresh_i3status
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && $refresh_i3status

# Brightness (adjust + show OSD)
bindsym XF86MonBrightnessUp exec --no-startup-id sh -c 'brightnessctl set +10%'
bindsym XF86MonBrightnessDown exec --no-startup-id sh -c 'brightnessctl set 10%-'

# Screenshots
set $screenshot_dir ~/Pictures/Screenshots
bindsym --release Print exec mkdir -p $screenshot_dir && grim $screenshot_dir/screenshot-$(date +%Y%m%d-%H%M%S).png
bindsym --release Shift+Print exec mkdir -p $screenshot_dir && grim -g "$(slurp)" $screenshot_dir/screenshot-$(date +%Y%m%d-%H%M%S).png
bindsym --release Ctrl+Print exec mkdir -p $screenshot_dir && grim -g "$(swaymsg -t get_tree | jq -j '.. | select(.type?) | select(.focused).rect | "\(.x),\(.y) \(.width)x\(.height)"')" $screenshot_dir/screenshot-$(date +%Y%m%d-%H%M%S).png
# Same three, for keyboards without a Print key (e.g. specter's ThinkBook 16)
bindsym --release $wndw+p exec mkdir -p $screenshot_dir && grim $screenshot_dir/screenshot-$(date +%Y%m%d-%H%M%S).png
bindsym --release $wndw+Shift+p exec mkdir -p $screenshot_dir && grim -g "$(slurp)" $screenshot_dir/screenshot-$(date +%Y%m%d-%H%M%S).png
bindsym --release $wndw+Ctrl+p exec mkdir -p $screenshot_dir && grim -g "$(swaymsg -t get_tree | jq -j '.. | select(.type?) | select(.focused).rect | "\(.x),\(.y) \(.width)x\(.height)"')" $screenshot_dir/screenshot-$(date +%Y%m%d-%H%M%S).png

# Lock screen
bindsym $wndw+l exec ~/.config/sway/scripts/lock.sh


# Mouse+$mod drags floating (and tiling if tiling_drag enabled)
floating_modifier $mod

# Terminal
bindsym $mod+Return exec $term

# Kill focused window
bindsym $mod+Shift+q kill

# Launchers
bindsym $mod+d exec $winmenu
bindsym $wndw+d exec $menu
bindsym $mod+$wndw+d exec dmenu_run   # (works via XWayland if you keep dmenu installed)

# "Settings manager" (xfce4-settings-manager is X11/DE-specific)
# Pick a Wayland-friendly replacement you like; examples:
bindsym $wndw+s exec nwg-look
# bindsym $wndw+s exec wdisplays
# For now keep your original (will run under XWayland if installed):

# Classic Alt-Tab-like behavior
focus_wrapping workspace

bindsym $mod+Shift+Tab focus left
bindsym $mod+Tab focus right
bindsym $mod+Control+Shift+Tab workspace prev_on_output
bindsym $mod+Control+Tab workspace next_on_output

# Focus (your arrows)
bindsym $mod+Down focus down
bindsym $mod+Up focus up

# Move focused window (your arrows)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Splits
bindsym $mod+h split h
bindsym $mod+v split v

# Fullscreen
bindsym $mod+f fullscreen toggle

# Layouts
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Floating
bindsym $mod+Shift+space floating toggle

# Parent focus
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Control+Shift+Right move container to workspace next_on_output; workspace next_on_output
bindsym $mod+Control+Shift+Left  move container to workspace prev_on_output; workspace prev_on_output

# --- Multi-monitor ---
# Output layout is now managed by kanshi (~/.config/kanshi/config). kanshi
# auto-applies profiles when outputs connect/disconnect, so plug/unplug of the
# dock just works. After rearranging in wdisplays, re-capture into kanshi's
# config (NOT here) with:
#   swaymsg -t get_outputs | jq -r '.[] | "    output \(.name) mode \(.current_mode.width)x\(.current_mode.height) position \(.rect.x),\(.rect.y) scale \(.scale)"'
# Do NOT add `output … position …` lines here — they'd fight with kanshi.

# Cross-monitor navigation. Mnemonic: Super ($wndw) = "between monitors",
# arrows = direction. Directions are spatial — they respect the physical 2D
# layout set in wdisplays (top row + laptop below).

# Directional focus (left/right/up/down) is unreliable when monitors overlap or
# are fractionally scaled, and `focus output next` isn't valid syntax. So we cycle
# by physical position via a helper that resolves target monitors by name.
# Mnemonic: Super = "between monitors"; Left/Right = previous/next monitor.
set $mnav ~/.config/sway/scripts/monitor-nav.sh

# Focus the previous/next monitor (wraps around)
bindsym $wndw+Left  exec $mnav focus prev
bindsym $wndw+Right exec $mnav focus next

# Send the focused window to the previous/next monitor
bindsym $wndw+Shift+Left  exec $mnav move-window prev
bindsym $wndw+Shift+Right exec $mnav move-window next

# Move the entire focused workspace to the previous/next monitor
bindsym $wndw+Control+Left  exec $mnav move-workspace prev
bindsym $wndw+Control+Right exec $mnav move-workspace next

# Reload config
bindsym $mod+Shift+c reload

# i3 "restart" doesn’t exist the same way in Sway; reload is the usual workflow
bindsym $mod+Shift+r reload

# Exit prompt (i3-nagbar -> swaynag)
bindsym $mod+Shift+e exec swaynag -t warning -m "Exit Sway?" -B "Yes, exit Sway" "swaymsg exit"

# Resize mode (same)
mode "resize" {
    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt

    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# --- Dual Bar Setup ---
# Top bar: System monitoring (workspaces, cpu, memory, gpu, temps, disk)
# Bottom bar: Controls (wifi, bluetooth, brightness, volume, battery, clock, tray)
exec_always pkill -x waybar; waybar --config ~/.config/waybar/config-top & waybar --config ~/.config/waybar/config-bottom &

# --- Host-specific overrides (keep last so they win) ---
# Per-machine config lives in ~/.config/sway/config.d/ — e.g. static `output`
# lines on desktops (see hosts/ in the linux-confs repo). The directory is
# created by install.sh; sway warns if the glob is empty, which is harmless.
include ~/.config/sway/config.d/*.conf

